rules_version = '2';

// A wedding document is shared by an allowlist of Google account emails.
// Only signed-in, verified users whose email is in memberEmails can read or
// write that wedding and its guest subcollection. Only the owner can change
// the allowlist or memberRoles. Parents and siblings may write guests only
// for their own role. The couple (groom/bride) and the owner are unrestricted.
// The client queries:
//   weddings where memberEmails array-contains request.auth.token.email
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function weddingData(weddingId) {
      return get(/databases/$(database)/documents/weddings/$(weddingId)).data;
    }

    function isMember(weddingId) {
      return signedIn() && myEmail() in weddingData(weddingId).memberEmails;
    }

    function isOwner(weddingId) {
      return weddingData(weddingId).ownerEmail == myEmail()
        || weddingData(weddingId).ownerEmail.lower() == myEmail().lower();
    }

    function hasRoleMap(weddingId) {
      return weddingData(weddingId).keys().hasAny(['memberRoles'])
        && weddingData(weddingId).memberRoles is map;
    }

    function myRole(weddingId) {
      return hasRoleMap(weddingId) && myEmail().lower() in weddingData(weddingId).memberRoles
        ? weddingData(weddingId).memberRoles[myEmail().lower()]
        : null;
    }

    function isRestricted(weddingId) {
      return !isOwner(weddingId)
        && myRole(weddingId) != null
        && myRole(weddingId) != 'groom'
        && myRole(weddingId) != 'bride';
    }

    function roleSide(role) {
      return role == 'bride' || role == 'bride_father' || role == 'bride_mother' || role == 'bride_brother' || role == 'bride_sister'
        ? 'bride'
        : 'groom';
    }

    function knownRole(role) {
      return role == 'groom' || role == 'groom_father' || role == 'groom_mother' || role == 'groom_brother' || role == 'groom_sister'
        || role == 'bride' || role == 'bride_father' || role == 'bride_mother' || role == 'bride_brother' || role == 'bride_sister';
    }

    function validWedding(data) {
      return data.keys().hasOnly(['name', 'ownerEmail', 'memberEmails', 'memberRoles', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'ownerEmail', 'memberEmails', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 120
        && data.ownerEmail is string
        && data.ownerEmail.size() > 3
        && data.ownerEmail.size() < 200
        && data.memberEmails is list
        && data.memberEmails.size() > 0
        && data.memberEmails.size() <= 40
        && data.createdAt is string
        && data.updatedAt is string
        && (!data.keys().hasAny(['memberRoles']) || (data.memberRoles is map && data.memberRoles.size() <= 40));
    }

    function validGuest(data) {
      return data.keys().hasOnly([
          'fullName',
          'phone',
          'side',
          'role',
          'group',
          'partySize',
          'partySizeAssumed',
          'rsvp',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() < 300
        && data.phone is string
        && data.phone.size() < 50
        && data.group is string
        && data.group.size() < 200
        && data.notes is string
        && data.notes.size() < 4000
        && data.partySize is int
        && data.partySize >= 1
        && data.partySize <= 100
        && data.partySizeAssumed is bool
        && data.rsvp in ['pending', 'attending', 'declined', 'maybe']
        && (data.side == null || data.side in ['groom', 'bride', 'shared'])
        && (data.role == null || knownRole(data.role))
        && (data.role == null || data.side == roleSide(data.role))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function guestWriteAllowed(weddingId) {
      return !isRestricted(weddingId)
        || (
          request.resource.data.role == myRole(weddingId)
          && request.resource.data.side == roleSide(myRole(weddingId))
        );
    }

    function canModerate(weddingId) {
      return isOwner(weddingId) || myRole(weddingId) == 'groom' || myRole(weddingId) == 'bride';
    }

    function validSong(data) {
      return data.keys().hasOnly([
          'title', 'artist', 'url', 'moment', 'notes', 'artworkUrl', 'previewUrl',
          'addedByEmail', 'addedByName', 'addedByRole', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() < 200
        && data.artist is string
        && data.artist.size() < 200
        && data.url is string
        && data.url.size() < 500
        && (data.url == '' || data.url.matches('https?://.+'))
        && (data.moment == null || data.moment in ['reception', 'chuppah', 'chuppah_entrance', 'glass', 'dancing', 'other'])
        && data.notes is string
        && data.notes.size() < 4000
        && (!data.keys().hasAny(['artworkUrl']) || (data.artworkUrl is string && data.artworkUrl.size() < 500 && (data.artworkUrl == '' || data.artworkUrl.matches('https://.+'))))
        && (!data.keys().hasAny(['previewUrl']) || (data.previewUrl is string && data.previewUrl.size() < 500 && (data.previewUrl == '' || data.previewUrl.matches('https://.+'))))
        && data.addedByEmail is string
        && data.addedByEmail.size() > 0
        && data.addedByEmail.size() < 200
        && data.addedByName is string
        && data.addedByName.size() < 200
        && (data.addedByRole == null || knownRole(data.addedByRole))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validVenue(data) {
      return data.keys().hasOnly([
          'name', 'city', 'phone', 'website', 'priceNotes', 'status', 'visitDate', 'notes',
          'tiktokUrls', 'addedByEmail', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 200
        && data.city is string
        && data.city.size() < 120
        && data.phone is string
        && data.phone.size() < 50
        && data.website is string
        && data.website.size() < 500
        && (data.website == '' || data.website.matches('https?://.+'))
        && data.priceNotes is string
        && data.priceNotes.size() < 500
        && data.status in ['want', 'scheduled', 'visited', 'rejected', 'chosen']
        && data.visitDate is string
        && data.visitDate.size() < 40
        && data.notes is string
        && data.notes.size() < 4000
        && data.tiktokUrls is list
        && data.tiktokUrls.size() <= 20
        && data.addedByEmail is string
        && data.addedByEmail.size() < 200
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /weddings/{weddingId} {
      allow read: if signedIn() && myEmail() in resource.data.memberEmails;

      allow create: if signedIn()
        && validWedding(request.resource.data)
        && request.resource.data.ownerEmail == myEmail()
        && myEmail() in request.resource.data.memberEmails;

      allow update: if signedIn()
        && isOwner(weddingId)
        && validWedding(request.resource.data)
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && myEmail() in request.resource.data.memberEmails
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      match /guests/{guestId} {
        allow read: if isMember(weddingId);
        allow create: if isMember(weddingId) && validGuest(request.resource.data) && guestWriteAllowed(weddingId);
        allow update: if isMember(weddingId)
          && validGuest(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && guestWriteAllowed(weddingId)
          && (!isRestricted(weddingId) || resource.data.role == myRole(weddingId));
        allow delete: if isMember(weddingId)
          && (!isRestricted(weddingId) || resource.data.role == myRole(weddingId));
      }

      match /songs/{songId} {
        allow read: if isMember(weddingId);
        allow create: if isMember(weddingId)
          && validSong(request.resource.data)
          && request.resource.data.addedByEmail == myEmail().lower();
        allow update: if isMember(weddingId)
          && validSong(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.addedByEmail == resource.data.addedByEmail
          && (canModerate(weddingId) || resource.data.addedByEmail == myEmail().lower());
        allow delete: if isMember(weddingId)
          && (canModerate(weddingId) || resource.data.addedByEmail == myEmail().lower());
      }

      match /venues/{venueId} {
        allow read: if isMember(weddingId);
        allow create: if isMember(weddingId)
          && canModerate(weddingId)
          && validVenue(request.resource.data)
          && request.resource.data.addedByEmail == myEmail().lower();
        allow update: if isMember(weddingId)
          && canModerate(weddingId)
          && validVenue(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.addedByEmail == resource.data.addedByEmail;
        allow delete: if isMember(weddingId) && canModerate(weddingId);
      }
    }
  }
}
