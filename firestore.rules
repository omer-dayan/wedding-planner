rules_version = '2';

// A wedding document is shared by an allowlist of Google account emails.
// Only signed-in, verified users whose email is in memberEmails can read or
// write that wedding and its guest subcollection. Only the owner can change
// the allowlist or memberRoles. Parents and siblings may write guests only
// for their own role. The couple (groom/bride) and the owner are unrestricted.
// The client queries:
//   weddings where memberEmails array-contains request.auth.token.email
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function weddingData(weddingId) {
      return get(/databases/$(database)/documents/weddings/$(weddingId)).data;
    }

    function isMember(weddingId) {
      return signedIn() && myEmail() in weddingData(weddingId).memberEmails;
    }

    function isOwner(weddingId) {
      return weddingData(weddingId).ownerEmail == myEmail()
        || weddingData(weddingId).ownerEmail.lower() == myEmail().lower();
    }

    function hasRoleMap(weddingId) {
      return weddingData(weddingId).keys().hasAny(['memberRoles'])
        && weddingData(weddingId).memberRoles is map;
    }

    function myRole(weddingId) {
      return hasRoleMap(weddingId) && myEmail().lower() in weddingData(weddingId).memberRoles
        ? weddingData(weddingId).memberRoles[myEmail().lower()]
        : null;
    }

    function isRestricted(weddingId) {
      return !isOwner(weddingId)
        && myRole(weddingId) != null
        && myRole(weddingId) != 'groom'
        && myRole(weddingId) != 'bride';
    }

    function roleSide(role) {
      return role == 'bride' || role == 'bride_father' || role == 'bride_mother' || role == 'bride_brother' || role == 'bride_sister'
        ? 'bride'
        : 'groom';
    }

    function knownRole(role) {
      return role == 'groom' || role == 'groom_father' || role == 'groom_mother' || role == 'groom_brother' || role == 'groom_sister'
        || role == 'bride' || role == 'bride_father' || role == 'bride_mother' || role == 'bride_brother' || role == 'bride_sister';
    }

    function validWedding(data) {
      return data.keys().hasOnly(['name', 'ownerEmail', 'memberEmails', 'memberRoles', 'weddingDate', 'venueQuestions', 'guestCategories', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'ownerEmail', 'memberEmails', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 120
        && data.ownerEmail is string
        && data.ownerEmail.size() > 3
        && data.ownerEmail.size() < 200
        && data.memberEmails is list
        && data.memberEmails.size() > 0
        && data.memberEmails.size() <= 40
        && data.createdAt is string
        && data.updatedAt is string
        && (!data.keys().hasAny(['memberRoles']) || (data.memberRoles is map && data.memberRoles.size() <= 40))
        && (!data.keys().hasAny(['weddingDate']) || (data.weddingDate is string && (data.weddingDate == '' || data.weddingDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))))
        && (!data.keys().hasAny(['venueQuestions']) || validQuestions(data.venueQuestions))
        && (!data.keys().hasAny(['guestCategories']) || validGuestCategories(data.guestCategories));
    }

    function validGuestCategory(c) {
      return c.keys().hasOnly(['id', 'label', 'parentId'])
        && c.id is string
        && c.id.size() > 0
        && c.id.size() < 80
        && c.id.matches('^[A-Za-z0-9_-]+$')
        && c.label is string
        && c.label.size() > 0
        && c.label.size() < 80
        && c.parentId is string
        && c.parentId.size() < 80;
    }

    function validGuestCategories(list) {
      return list is list
        && list.size() <= 40
        && (list.size() < 1 || validGuestCategory(list[0]))
        && (list.size() < 2 || validGuestCategory(list[1]))
        && (list.size() < 3 || validGuestCategory(list[2]))
        && (list.size() < 4 || validGuestCategory(list[3]))
        && (list.size() < 5 || validGuestCategory(list[4]))
        && (list.size() < 6 || validGuestCategory(list[5]))
        && (list.size() < 7 || validGuestCategory(list[6]))
        && (list.size() < 8 || validGuestCategory(list[7]))
        && (list.size() < 9 || validGuestCategory(list[8]))
        && (list.size() < 10 || validGuestCategory(list[9]))
        && (list.size() < 11 || validGuestCategory(list[10]))
        && (list.size() < 12 || validGuestCategory(list[11]))
        && (list.size() < 13 || validGuestCategory(list[12]))
        && (list.size() < 14 || validGuestCategory(list[13]))
        && (list.size() < 15 || validGuestCategory(list[14]))
        && (list.size() < 16 || validGuestCategory(list[15]))
        && (list.size() < 17 || validGuestCategory(list[16]))
        && (list.size() < 18 || validGuestCategory(list[17]))
        && (list.size() < 19 || validGuestCategory(list[18]))
        && (list.size() < 20 || validGuestCategory(list[19]))
        && (list.size() < 21 || validGuestCategory(list[20]))
        && (list.size() < 22 || validGuestCategory(list[21]))
        && (list.size() < 23 || validGuestCategory(list[22]))
        && (list.size() < 24 || validGuestCategory(list[23]))
        && (list.size() < 25 || validGuestCategory(list[24]))
        && (list.size() < 26 || validGuestCategory(list[25]))
        && (list.size() < 27 || validGuestCategory(list[26]))
        && (list.size() < 28 || validGuestCategory(list[27]))
        && (list.size() < 29 || validGuestCategory(list[28]))
        && (list.size() < 30 || validGuestCategory(list[29]))
        && (list.size() < 31 || validGuestCategory(list[30]))
        && (list.size() < 32 || validGuestCategory(list[31]))
        && (list.size() < 33 || validGuestCategory(list[32]))
        && (list.size() < 34 || validGuestCategory(list[33]))
        && (list.size() < 35 || validGuestCategory(list[34]))
        && (list.size() < 36 || validGuestCategory(list[35]))
        && (list.size() < 37 || validGuestCategory(list[36]))
        && (list.size() < 38 || validGuestCategory(list[37]))
        && (list.size() < 39 || validGuestCategory(list[38]))
        && (list.size() < 40 || validGuestCategory(list[39]));
    }

    function validQuestion(q) {
      return q.keys().hasOnly(['id', 'label', 'type', 'pricePart'])
        && q.id is string
        && q.id.size() > 0
        && q.id.size() < 80
        && q.id.matches('^[A-Za-z0-9_-]+$')
        && q.label is string
        && q.label.size() > 0
        && q.label.size() < 120
        && q.type in ['text', 'number', 'yesno', 'long']
        && (!q.keys().hasAny(['pricePart']) || q.pricePart in ['base', 'add', 'split', 'percent', 'guests', 'skip']);
    }

    function validQuestions(list) {
      return list is list
        && list.size() <= 20
        && (list.size() < 1 || validQuestion(list[0]))
        && (list.size() < 2 || validQuestion(list[1]))
        && (list.size() < 3 || validQuestion(list[2]))
        && (list.size() < 4 || validQuestion(list[3]))
        && (list.size() < 5 || validQuestion(list[4]))
        && (list.size() < 6 || validQuestion(list[5]))
        && (list.size() < 7 || validQuestion(list[6]))
        && (list.size() < 8 || validQuestion(list[7]))
        && (list.size() < 9 || validQuestion(list[8]))
        && (list.size() < 10 || validQuestion(list[9]))
        && (list.size() < 11 || validQuestion(list[10]))
        && (list.size() < 12 || validQuestion(list[11]))
        && (list.size() < 13 || validQuestion(list[12]))
        && (list.size() < 14 || validQuestion(list[13]))
        && (list.size() < 15 || validQuestion(list[14]))
        && (list.size() < 16 || validQuestion(list[15]))
        && (list.size() < 17 || validQuestion(list[16]))
        && (list.size() < 18 || validQuestion(list[17]))
        && (list.size() < 19 || validQuestion(list[18]))
        && (list.size() < 20 || validQuestion(list[19]));
    }

    function validGuest(data) {
      return data.keys().hasOnly([
          'fullName',
          'phone',
          'side',
          'subSide',
          'category',
          'role',
          'group',
          'categoryId',
          'partySize',
          'partySizeAssumed',
          'rsvp',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() < 300
        && data.phone is string
        && data.phone.size() < 50
        && data.group is string
        && data.group.size() < 200
        && (!data.keys().hasAny(['categoryId']) || (data.categoryId is string && data.categoryId.size() < 80))
        && data.notes is string
        && data.notes.size() < 4000
        && data.partySize is int
        && data.partySize >= 1
        && data.partySize <= 100
        && data.partySizeAssumed is bool
        && data.rsvp in ['pending', 'attending', 'declined', 'maybe']
        && (data.side == null || data.side in ['groom', 'bride', 'shared'])
        && (data.role == null || knownRole(data.role))
        && (data.role == null || data.side == null || data.side == roleSide(data.role))
        && (!data.keys().hasAny(['subSide']) || data.subSide == null || data.subSide in ['none', 'parents', 'brother', 'sister'])
        && (!data.keys().hasAny(['category']) || data.category in ['family', 'friends', 'work', 'other'])
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function subSideOf(data) {
      return data.keys().hasAny(['subSide']) && data.subSide != null ? data.subSide : 'none';
    }

    function mySubSide(weddingId) {
      return myRole(weddingId) == 'groom_father' || myRole(weddingId) == 'groom_mother'
          || myRole(weddingId) == 'bride_father' || myRole(weddingId) == 'bride_mother' ? 'parents'
        : myRole(weddingId) == 'groom_brother' || myRole(weddingId) == 'bride_brother' ? 'brother'
        : myRole(weddingId) == 'groom_sister' || myRole(weddingId) == 'bride_sister' ? 'sister'
        : 'none';
    }

    function inMyBucket(weddingId, data) {
      return data.side == roleSide(myRole(weddingId)) && subSideOf(data) == mySubSide(weddingId);
    }

    function guestWriteAllowed(weddingId) {
      return !isRestricted(weddingId) || inMyBucket(weddingId, request.resource.data);
    }

    function canModerate(weddingId) {
      return isOwner(weddingId) || myRole(weddingId) == 'groom' || myRole(weddingId) == 'bride';
    }

    function validSong(data) {
      return data.keys().hasOnly([
          'title', 'artist', 'url', 'moment', 'notes', 'artworkUrl', 'previewUrl',
          'addedByEmail', 'addedByName', 'addedByRole', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() < 200
        && data.artist is string
        && data.artist.size() < 200
        && data.url is string
        && data.url.size() < 500
        && (data.url == '' || data.url.matches('https?://.+'))
        && (data.moment == null || data.moment in ['reception', 'chuppah', 'chuppah_entrance', 'glass', 'dancing', 'other'])
        && data.notes is string
        && data.notes.size() < 4000
        && (!data.keys().hasAny(['artworkUrl']) || (data.artworkUrl is string && data.artworkUrl.size() < 500 && (data.artworkUrl == '' || data.artworkUrl.matches('https://.+'))))
        && (!data.keys().hasAny(['previewUrl']) || (data.previewUrl is string && data.previewUrl.size() < 500 && (data.previewUrl == '' || data.previewUrl.matches('https://.+'))))
        && data.addedByEmail is string
        && data.addedByEmail.size() > 0
        && data.addedByEmail.size() < 200
        && data.addedByName is string
        && data.addedByName.size() < 200
        && (data.addedByRole == null || knownRole(data.addedByRole))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validVenue(data) {
      return data.keys().hasOnly([
          'name', 'city', 'phone', 'website', 'priceNotes', 'status', 'visitDate', 'notes',
          'tiktokUrls', 'answers', 'imageUrl', 'addedByEmail', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 200
        && data.city is string
        && data.city.size() < 120
        && data.phone is string
        && data.phone.size() < 50
        && data.website is string
        && data.website.size() < 500
        && (data.website == '' || data.website.matches('https?://.+'))
        && data.priceNotes is string
        && data.priceNotes.size() < 500
        && data.status in ['want', 'scheduled', 'visited', 'rejected', 'chosen']
        && data.visitDate is string
        && data.visitDate.size() < 40
        && data.notes is string
        && data.notes.size() < 4000
        && data.tiktokUrls is list
        && data.tiktokUrls.size() <= 20
        && (!data.keys().hasAny(['answers']) || (data.answers is map && data.answers.size() <= 40))
        && (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() < 180000 && (data.imageUrl == '' || data.imageUrl.matches('https://.+') || data.imageUrl.matches('data:image/.+'))))
        && data.addedByEmail is string
        && data.addedByEmail.size() < 200
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validActivity(data) {
      return data.keys().hasOnly([
          'type', 'entity', 'entityId', 'entityName', 'actorEmail', 'actorName', 'actorRole', 'actorPhotoUrl', 'createdAt', 'details'
        ])
        && data.type in [
          'guest_added', 'guest_edited', 'guest_deleted', 'rsvp_changed', 'guests_imported',
          'song_added', 'song_deleted', 'venue_added', 'venue_status', 'venue_video',
          'venue_questions', 'venue_answers', 'member_added', 'role_changed'
        ]
        && data.entity in ['guest', 'song', 'venue', 'member', 'rsvp']
        && data.entityId is string
        && data.entityId.size() > 0
        && data.entityId.size() < 200
        && data.entityName is string
        && data.entityName.size() < 300
        && data.actorEmail is string
        && data.actorEmail.size() > 0
        && data.actorEmail.size() < 200
        && data.actorName is string
        && data.actorName.size() < 200
        && (data.actorRole == null || knownRole(data.actorRole))
        && data.actorPhotoUrl is string
        && data.actorPhotoUrl.size() < 1000
        && (data.actorPhotoUrl == '' || data.actorPhotoUrl.matches('https://.+'))
        && data.createdAt == request.time
        && data.details is map
        && data.details.keys().hasOnly(['from', 'to', 'count', 'names', 'fields', 'artworkUrl'])
        && data.details.from is string
        && data.details.from.size() < 200
        && data.details.to is string
        && data.details.to.size() < 200
        && data.details.count is int
        && data.details.count >= 0
        && data.details.count <= 500
        && data.details.names is list
        && data.details.names.size() <= 8
        && data.details.fields is list
        && data.details.fields.size() <= 12
        && data.details.artworkUrl is string
        && data.details.artworkUrl.size() < 500
        && (data.details.artworkUrl == '' || data.details.artworkUrl.matches('https://.+'));
    }

    function validActivityComment(data) {
      return data.keys().hasOnly([
          'eventId', 'text', 'actorEmail', 'actorName', 'actorRole', 'actorPhotoUrl', 'createdAt'
        ])
        && data.eventId is string
        && data.eventId.size() > 0
        && data.eventId.size() < 200
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 1000
        && data.actorEmail is string
        && data.actorEmail.size() > 0
        && data.actorEmail.size() < 200
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() < 200
        && (data.actorRole == null || knownRole(data.actorRole))
        && data.actorPhotoUrl is string
        && data.actorPhotoUrl.size() < 1000
        && (data.actorPhotoUrl == '' || data.actorPhotoUrl.matches('https://.+'))
        && data.createdAt == request.time;
    }

    match /weddings/{weddingId} {
      allow read: if signedIn() && myEmail() in resource.data.memberEmails;

      allow create: if signedIn()
        && validWedding(request.resource.data)
        && request.resource.data.ownerEmail == myEmail()
        && myEmail() in request.resource.data.memberEmails;

      allow update: if signedIn()
        && validWedding(request.resource.data)
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            isOwner(weddingId)
            && myEmail() in request.resource.data.memberEmails
          )
          || (
            canModerate(weddingId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weddingDate', 'venueQuestions', 'guestCategories', 'updatedAt'])
          )
        );

      allow delete: if false;

      match /guests/{guestId} {
        allow read: if isMember(weddingId);
        allow create: if isMember(weddingId) && validGuest(request.resource.data) && guestWriteAllowed(weddingId);
        allow update: if isMember(weddingId)
          && validGuest(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && guestWriteAllowed(weddingId)
          && (!isRestricted(weddingId) || inMyBucket(weddingId, resource.data));
        allow delete: if isMember(weddingId)
          && (!isRestricted(weddingId) || inMyBucket(weddingId, resource.data));
      }

      match /songs/{songId} {
        allow read: if isMember(weddingId);
        allow create: if isMember(weddingId)
          && validSong(request.resource.data)
          && request.resource.data.addedByEmail == myEmail().lower();
        allow update: if isMember(weddingId)
          && validSong(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.addedByEmail == resource.data.addedByEmail
          && (canModerate(weddingId) || resource.data.addedByEmail == myEmail().lower());
        allow delete: if isMember(weddingId)
          && (canModerate(weddingId) || resource.data.addedByEmail == myEmail().lower());
      }

      match /venues/{venueId} {
        allow read: if isMember(weddingId);
        allow create: if isMember(weddingId)
          && canModerate(weddingId)
          && validVenue(request.resource.data)
          && request.resource.data.addedByEmail == myEmail().lower();
        allow update: if isMember(weddingId)
          && canModerate(weddingId)
          && validVenue(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.addedByEmail == resource.data.addedByEmail;
        allow delete: if isMember(weddingId) && canModerate(weddingId);
      }

      match /activity/{eventId} {
        allow read: if canModerate(weddingId);
        allow create: if isMember(weddingId)
          && validActivity(request.resource.data)
          && (request.resource.data.actorEmail == myEmail() || request.resource.data.actorEmail == myEmail().lower());
        allow update: if false;
        allow delete: if isOwner(weddingId);
      }

      match /activityComments/{commentId} {
        allow read: if canModerate(weddingId);
        allow create: if canModerate(weddingId)
          && validActivityComment(request.resource.data)
          && (request.resource.data.actorEmail == myEmail() || request.resource.data.actorEmail == myEmail().lower());
        allow update: if false;
        allow delete: if canModerate(weddingId)
          && (
            isOwner(weddingId)
            || resource.data.actorEmail == myEmail()
            || resource.data.actorEmail == myEmail().lower()
          );
      }
    }
  }
}
